                <?php $r = $block->getRefund(); ?>
                <dt><?= $escaper->escapeHtml(__('Refund total')) ?></dt>
                <dd class="mm-eu-w-verify-strong"><?= $escaper->escapeHtml($block->formatAmount($r['total'])) ?></dd>

                <?php if ($block->getMerchantName() !== ''): ?>
                    <dt><?= $escaper->escapeHtml(__('Merchant')) ?></dt>
                    <dd><?= $escaper->escapeHtml($block->getMerchantName()) ?></dd>
                <?php endif; ?>

                <?php if ($block->getArticleRef() !== ''): ?>
                    <dt><?= $escaper->escapeHtml(__('Legal basis')) ?></dt>
                    <dd><?= $escaper->escapeHtml($block->getArticleRef()) ?></dd>
                <?php endif; ?>
            </dl>
        </div>

        <?php $items = $block->getItems(); ?>
        <?php if ($items !== []): ?>
            <!-- Items -->
            <div class="mm-eu-w-verify-card">
                <h3 class="mm-eu-w-verify-card-title">
                    <?= $escaper->escapeHtml(__('Returned items')) ?>
                    <span class="mm-eu-w-verify-count">(<?= (int) count($items) ?>)</span>
                </h3>
                <ul class="mm-eu-w-verify-items">
                    <?php foreach ($items as $item): ?>
                        <li class="mm-eu-w-verify-item">
                            <span class="mm-eu-w-verify-item-meta">
                                <strong><?= $escaper->escapeHtml(__('SKU %1', (string) ($item['sku'] ?? ''))) ?></strong>
                            </span>
                            <span class="mm-eu-w-verify-item-qty">
                                <?= $escaper->escapeHtml(__('Qty %1', (int) ($item['qty'] ?? 0))) ?>
                            </span>
                            <span class="mm-eu-w-verify-item-refund">
                                <?= $escaper->escapeHtml($block->formatAmount((string) ($item['refund_amount'] ?? '0.00'))) ?>
                            </span>
                        </li>
                    <?php endforeach; ?>
                </ul>
                <div class="mm-eu-w-verify-totals">
                    <?php if ((float) $r['shipping'] > 0): ?>
                        <div class="mm-eu-w-verify-totals-row">
                            <span><?= $escaper->escapeHtml(__('Shipping refund')) ?></span>
                            <span><?= $escaper->escapeHtml($block->formatAmount($r['shipping'])) ?></span>
