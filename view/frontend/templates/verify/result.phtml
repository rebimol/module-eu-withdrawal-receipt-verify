                </a>
            </div>
        </div>

        <!-- Receipt details -->
        <div class="mm-eu-w-verify-card">
            <h3 class="mm-eu-w-verify-card-title"><?= $escaper->escapeHtml(__('Receipt details')) ?></h3>
            <dl class="mm-eu-w-verify-facts">
                <dt><?= $escaper->escapeHtml(__('Receipt number')) ?></dt>
                <dd>RR<?= $escaper->escapeHtml($block->getIncrementIdDisplay()) ?></dd>

                <?php if ($block->getOrderNumber() !== ''): ?>
                    <dt><?= $escaper->escapeHtml(__('Order number')) ?></dt>
                    <dd>#<?= $escaper->escapeHtml($block->getOrderNumber()) ?></dd>
