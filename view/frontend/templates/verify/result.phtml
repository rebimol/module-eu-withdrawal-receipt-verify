                        <div class="mm-eu-w-verify-totals-row">
                            <span><?= $escaper->escapeHtml(__('Tax refund')) ?></span>
                            <span><?= $escaper->escapeHtml($block->formatAmount($r['tax'])) ?></span>
                        </div>
                    <?php endif; ?>
                    <div class="mm-eu-w-verify-totals-row mm-eu-w-verify-totals-grand">
                        <span><?= $escaper->escapeHtml(__('Total refund')) ?></span>
                        <span><?= $escaper->escapeHtml($block->formatAmount($r['total'])) ?></span>
                    </div>
                </div>
            </div>
        <?php endif; ?>

        <!-- Integrity hash -->
        <div class="mm-eu-w-verify-card mm-eu-w-verify-hash-card">
            <div class="mm-eu-w-verify-hash-header">
                <h3 class="mm-eu-w-verify-card-title"><?= $escaper->escapeHtml(__('Integrity hash (SHA-256)')) ?></h3>
                <button type="button"
                        class="mm-eu-w-verify-copy"
                        data-copy="<?= $escaper->escapeHtmlAttr($block->getContentHash()) ?>"
                        aria-label="<?= $escaper->escapeHtmlAttr(__('Copy hash')) ?>">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" /><path d="M5 15V5a2 2 0 0 1 2-2h10" /></svg>
                    <span><?= $escaper->escapeHtml(__('Copy')) ?></span>
                </button>
            </div>
            <code class="mm-eu-w-verify-hash"><?= $escaper->escapeHtml($block->getContentHashDisplay()) ?></code>
            <p class="mm-eu-w-verify-hash-help">
                <?= $escaper->escapeHtml(__('Anyone holding the original receipt email can recompute this hash to confirm the receipt has not been altered. Mismatch means the receipt was modified after issuance.')) ?>
            </p>
        </div>

        <p class="mm-eu-w-verify-foot-disclaimer">
            <?= $escaper->escapeHtml(__('This page is anti-indexed (X-Robots-Tag: noindex) and rate-limited. Repeated verification attempts from the same IP are throttled.')) ?>
        </p>

        <script type="text/javascript">
        (function () {
            'use strict';
            var btn = document.querySelector('.mm-eu-w-verify-copy');
            if (!btn) { return; }
            btn.addEventListener('click', function () {
                var hash = btn.getAttribute('data-copy') || '';
                if (!navigator.clipboard) { return; }
                navigator.clipboard.writeText(hash).then(function () {
                    var label = btn.querySelector('span');
                    if (!label) { return; }
                    var orig = label.textContent;
                    label.textContent = 'Copied';
                    btn.classList.add('is-copied');
                    setTimeout(function () { label.textContent = orig; btn.classList.remove('is-copied'); }, 1500);
                });
            });
        })();
        </script>
    <?php else: ?>
        <!-- Failure state -->
        <div class="mm-eu-w-verify-hero mm-eu-w-verify-hero--fail">
            <div class="mm-eu-w-verify-badge mm-eu-w-verify-badge--fail" aria-hidden="true">
